<script>

function ding(){
  try{
    const ctx=new(window.AudioContext||window.webkitAudioContext)();
    const osc=ctx.createOscillator();
    const gain=ctx.createGain();

    osc.frequency.value=880;

    gain.gain.setValueAtTime(.12,ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(
      .001,
      ctx.currentTime+.18
    );

    osc.connect(gain);
    gain.connect(ctx.destination);

    osc.start();
    osc.stop(ctx.currentTime+.18);
  }catch(e){}
}


function go(n){

  document
  .querySelectorAll(".screen")
  .forEach(x=>x.classList.remove("active"));

  document
  .getElementById("s"+n)
  .classList.add("active");

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });

  if(n===7){
    startStars();
  }
}


function password(){

  const v=document
  .getElementById("pass")
  .value
  .trim()
  .toLowerCase();

  const m=document.getElementById("passMsg");

  if(v==="amore"){

    m.textContent=
    "🔓 ACCESO CONCEDIDO. Sabía que lo recordarías. 💙";

    ding();

    setTimeout(()=>go(2),1000);

  }else{

    m.textContent=
    "❌ Esa no es... Pista 1: era un apodo. 👀";

    setTimeout(()=>{

      m.textContent=
      "💡 Pista 2: era una forma cariñosa de llamar a alguien. 💙";

    },1800);

    setTimeout(()=>{

      m.textContent=
      "👀 Última pista: A _ O R E";

    },3800);

  }
}


function correct(btn,next,msgId){

  btn.classList.add("correct");

  document
  .getElementById(msgId)
  .textContent=
  "⭐ CORRECTO. La pista ha sido desbloqueada. 💙";

  ding();

  setTimeout(()=>go(next),900);
}


function wrong(btn,msgId){

  btn.classList.add("wrong");

  document
  .getElementById(msgId)
  .textContent=
  "❌ No era esa 😭. Inténtalo otra vez.";

  setTimeout(()=>{
    btn.classList.remove("wrong");
  },700);
}


let stars=[];
let found=0;

function startStars(){

  const area=document.getElementById("starField");

  area.innerHTML="";
  found=0;

  document.getElementById("starCount").textContent="0 / 5";
  document.getElementById("starNext").style.display="none";
  document.getElementById("starMsg").textContent="";
  document.getElementById("starInstruction").textContent=
  "Mira atentamente... las estrellas especiales aparecerán durante 4 segundos.";

  stars=[];

  for(let i=0;i<25;i++){

    const s=document.createElement("span");

    s.className="star";
    s.textContent=i<5?"✦":"★";

    s.style.left=(5+Math.random()*88)+"%";
    s.style.top=(5+Math.random()*82)+"%";

    if(i<5){

      s.classList.add("secret");

      s.dataset.correct="true";

    }

    s.onclick=function(){

      if(s.dataset.correct==="true"){
        findSecret(s);
      }else{
        wrongStar(s);
      }

    };

    area.appendChild(s);
    stars.push(s);
  }

  setTimeout(()=>{

    stars.forEach(s=>{

      if(s.dataset.correct==="true"){
        s.textContent="★";
        s.classList.remove("secret");
      }

    });

    document.getElementById("starInstruction").textContent=
    "¡Ahora encuéntralas! ⭐";

  },4000);
}


function findSecret(s){

  if(s.classList.contains("found"))return;

  s.classList.add("found");

  found++;

  ding();

  document.getElementById("starCount").textContent=
  found+" / 5";

  if(found===5){

    document.getElementById("starMsg").textContent=
    "⭐ TODAS ENCONTRADAS. Detective nivel: la mejor 🥳💜";

    document.getElementById("starNext").style.display=
    "inline-block";
  }
}


function wrongStar(s){

  s.style.transform="scale(.7)";

  document.getElementById("starMsg").textContent=
  "❌ Esa no era... mira bien 😭💙";

  setTimeout(()=>{
    s.style.transform="";
  },400);
}


const memories=[
"📁 Registro 01: Todo comenzó en aquel live.",
"📁 Registro 02: Hubo una palabra que se convirtió en apodo: amore. 💙",
"📁 Registro 03: Cada coincidencia podía terminar en TWINS. ⭐",
"📁 Registro 04: Mindy tiene una debilidad bastante evidente por los caballos. 🐴",
"📁 Registro 05: London — Freya Skye quedó guardada como un pequeño recuerdo musical. 🎵",
"🔐 ARCHIVO OCULTO: La persona que creó todo esto es... tu amiga más pro 😘💜"
];

let opened=[];

function memory(i){

  if(!opened.includes(i)){
    opened.push(i);
  }

  const box=document.getElementById("memoryText");

  box.style.display="block";
  box.textContent=memories[i];

  ding();

  if(opened.length===6){

    setTimeout(()=>{

      box.textContent=
      "⭐ TODOS LOS RECUERDOS ABIERTOS ⭐\n\n"+
      "Ahora sí has encontrado la última pista.\n\n"+
      "No era una contraseña.\n"+
      "Era recordar quién estaba al otro lado.\n\n"+
      "💜 Tu amiga más pro 😘";

      document.getElementById("finalUnlock")
      .style.display="inline-block";

    },500);
  }
}


function revealLetter(){

  ding();

  document.getElementById("letterContent")
  .style.display="block";

  document
  .querySelector(".envelope")
  .style.display="none";

